# Copy to .env and adjust. Never commit .env.

# --- Application ---
# ENVIRONMENT: local | test | staging | production
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# Set LOG_JSON=true in staging/production
LOG_JSON=false

# --- PostgreSQL ---
# docker compose overrides POSTGRES_HOST to "db" for the api container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finledger
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=finledger
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Authentication ---
# Required, at least 32 characters. The app refuses to start while this is empty.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Docker Compose host ports (bound to 127.0.0.1 only) ---
API_PORT=8000
POSTGRES_HOST_PORT=5432
